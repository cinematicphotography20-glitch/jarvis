function openWebsite(command) {
  let text = command.toLowerCase()
    .replace("open ", "")
    .replace("kholo", "")
    .replace(" खोलो", "")
    .trim();

  if (websites[text]) {
    speak("Opening " + text);
    window.location.href = websites[text];
  } else {
    speak("Website nahi mili. Google par search kar raha hoon.");
    window.location.href =
      "https://www.google.com/search?q=" +
      encodeURIComponent(text);
  }
}
